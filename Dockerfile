FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_API_BASE_URL=/api
ARG NEXT_PUBLIC_DISPLAY_TIME_ZONE=UTC
ARG NEXT_PUBLIC_APP_ENV=development
ARG NEXT_PUBLIC_APP_VERSION=local
ARG NEXT_PUBLIC_ENABLE_TELEMETRY=false
ARG NEXT_PUBLIC_FARO_URL
ARG NEXT_PUBLIC_UMAMI_SCRIPT_URL
ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID
ARG NEXT_PUBLIC_UMAMI_DOMAINS
ARG NEXT_PUBLIC_GRAFANA_DASHBOARD_URL
ARG NEXT_PUBLIC_UMAMI_DASHBOARD_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM nginx:1.28-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html/store
EXPOSE 80

